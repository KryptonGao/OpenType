    "此 Key 单独保存，与语音识别、AI 处理的 Key 互不影响。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Key 单独保存，与语音识别、AI 处理的 Key 互不影响。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This key is stored separately and is independent of the speech recognition and AI processing keys."
          }
