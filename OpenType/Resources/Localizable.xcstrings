          }
        }
      }
    },
    "录音会实时发送到阿里云百炼进行识别；默认不在本地保存音频与识别记录。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音会实时发送到阿里云百炼进行识别；默认不在本地保存音频与识别记录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio is streamed to Alibaba Cloud Bailian for recognition in real time; audio and recognition records are not saved locally by default."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音會即時傳送到阿里雲百煉進行辨識；預設不在本機儲存音訊與辨識記錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音は認識のためにリアルタイムで Alibaba Cloud 百煉（Bailian）に送信されます。デフォルトでは、音声と認識記録はローカルに保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음은 인식을 위해 실시간으로 알리바바 클라우드 바이롄(Bailian)에 전송되며, 기본적으로 오디오와 인식 기록은 로컬에 저장되지 않습니다."
          }
        }
      }
    },
    "录音时长": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音时长"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording Time"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音時長"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音時間"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 시간"
          }
        }
      }
    },
    "录音期间已切换应用，无法写回「%@」": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音期间已切换应用，无法写回「%@」"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You switched apps while recording; can’t write back to “%@”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音期間已切換 App，無法寫回「%@」"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音中にアプリが切り替わったため、「%@」に書き戻せません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 중에 앱이 전환되어 '%@'에 쓸 수 없습니다"
          }
        }
      }
    },
    "录音结束后会以 WAV 文件整段发送到 DeepSeek（api.deepseek.com）进行识别；默认不在本地保存音频与识别记录。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音结束后会以 WAV 文件整段发送到 DeepSeek（api.deepseek.com）进行识别；默认不在本地保存音频与识别记录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After recording ends, the whole recording is sent as a WAV file to DeepSeek (api.deepseek.com) for recognition; audio and recognition records are not saved locally by default."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音結束後會以 WAV 檔整段傳送到 DeepSeek（api.deepseek.com）進行辨識；預設不在本機儲存音訊與辨識記錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音終了後、録音全体が WAV ファイルとして DeepSeek（api.deepseek.com）に送信され、認識されます。デフォルトでは、音声と認識記録はローカルに保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음이 끝나면 전체 녹음이 WAV 파일로 DeepSeek(api.deepseek.com)에 전송되어 인식됩니다. 기본적으로 오디오와 인식 기록은 로컬에 저장되지 않습니다."
          }
        }
      }
    },
