        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想寫什麼？例如：寫一封向主管請兩天假的郵件"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何を書きますか？例：上司に 2 日間の休暇を願い出るメール"
