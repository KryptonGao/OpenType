          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音辨識驗證失敗（HTTP %lld），請檢查 API Key（百煉還需檢查 Workspace ID）"
          }
        },
        "ja": {
          "stringUnit": {
