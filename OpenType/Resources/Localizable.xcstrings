    "用逗号分隔，例如 gee hub、吉特哈布": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用逗号分隔，例如 gee hub、吉特哈布"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate with commas, e.g. gee hub, git hub"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用逗號分隔，例如 gee hub、吉特哈布"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カンマで区切ります。例: gee hub, git hub"
          }
        },
