            "value": "現在のプロファイル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 프로필"
          }
        }
      }
    },
    "录音会实时发送到阿里云百炼进行识别；默认不在本地保存音频与识别记录。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音会实时发送到阿里云百炼进行识别；默认不在本地保存音频与识别记录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio is streamed to Alibaba Cloud Bailian for recognition in real time; audio and recognition records are not saved locally by default."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音會即時傳送到阿里雲百煉進行辨識；預設不在本機儲存音訊與辨識記錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音は認識のためにリアルタイムで Alibaba Cloud 百煉（Bailian）に送信されます。デフォルトでは、音声と認識記録はローカルに保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음은 인식을 위해 실시간으로 알리바바 클라우드 바이롄(Bailian)에 전송되며, 기본적으로 오디오와 인식 기록은 로컬에 저장되지 않습니다."
          }
        }
      }
    },
    "录音时长": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音时长"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording Time"
          }
        },
        "zh-Hant": {
          "stringUnit": {
