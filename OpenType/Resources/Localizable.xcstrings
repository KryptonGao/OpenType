        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有權限取代目前的 App。請先將 OpenType 移到「應用程式」資料夾，或手動下載安裝"
          }
        },
        "ja": {
          "stringUnit": {
