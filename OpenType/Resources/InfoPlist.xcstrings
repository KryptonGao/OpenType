        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenType はリアルタイムの音声認識と音声入力のためにマイクへのアクセスを必要とします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenType은 실시간 음성 인식과 받아쓰기를 위해 마이크에 접근해야 합니다."
          }
        },
